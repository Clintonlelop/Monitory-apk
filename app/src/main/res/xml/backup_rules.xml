<?xml version="1.0" encoding="utf-8"?>
<!--
  Full backup content rules (pre-Android 12).
  Excludes sensitive runtime data from backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="device_prefs.xml" />
    <exclude domain="database" path="app_database" />
    <exclude domain="database" path="app_database-wal" />
    <exclude domain="database" path="app_database-shm" />
</full-backup-content>
