<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 12+ (dataExtractionRules).
  Excludes sensitive runtime data from backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="device_prefs.xml" />
        <exclude domain="database" path="app_database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="device_prefs.xml" />
        <exclude domain="database" path="app_database" />
    </device-transfer>
</data-extraction-rules>
