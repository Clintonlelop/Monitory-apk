<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext for development (configurable). In production, use HTTPS/WSS only. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
