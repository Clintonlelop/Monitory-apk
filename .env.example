# Monitory backend configuration — copy to .env and fill in real values.
# NEVER commit the .env file or real secrets.

# HTTP port for the backend
PORT=3000

# REQUIRED in production. Generate a fresh random value per deployment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Treat any previously committed secret as compromised and rotate it.
JWT_SECRET=

# Optional: first administrator bootstrap (only applied while the users table
# is empty; ignored on deployments that already have accounts).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=

# Optional: allow browser CORS from these origins (comma separated).
# Leave empty for same-origin only (recommended when the dashboard is served
# by this same backend).
CORS_ORIGIN=

# Optional: advertise a fixed public URL to pairing clients (otherwise derived
# from the request's Host / X-Forwarded-Proto headers).
# PUBLIC_SERVER_URL=https://fleet.example.com

# Optional Database (falls back to the embedded in-memory store if omitted —
# the in-memory store is lost on every restart; use PostgreSQL in production).
DATABASE_URL=
PGHOST=
PGUSER=
PGPASSWORD=
PGPORT=5432
PGDATABASE=devicemanager

# Docker Compose only:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=devicemanager
